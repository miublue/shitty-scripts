#!/bin/sh

# i got some weird ass sound card on this goofy ass chinese ass laptop

if [ -z "$(get_bluetooth_info)" ]; then
    getcmd() {
        amixer -c 1 get PCM
    }

    setcmd() {
        amixer -c 1 set PCM $@
    }
else
    getcmd() {
        amixer get Master
    }

    setcmd() {
        amixer set Master $@
    }
fi

if [ -z "$1" ]; then
    v="$(getcmd 2> /dev/null | grep 'Left: ')"
    s="$(echo $v | grep '\[off\]')"
    [ -z "$s" ] && s="On" || s="Off"
    n="$(echo $v | awk '{printf "%s",$5;}' | sed 's/\[\(.*\)\]/\1/')"
    [ -z "$n" ] && v="0%" || v="$n"
    printf "%s %s\n" "$v" "$s"
    exit
fi

case "$1" in
    m|t|mute|toggle)
        setcmd toggle
    ;;
    *)
        setcmd $1
    ;;
esac
